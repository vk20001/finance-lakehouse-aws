-- /* {"app": "dbt", "dbt_version": "1.10.13", "profile_name": "finance_lakehouse", "target_name": "dev", "node_id": "model.finance_lakehouse.returns"} */
create table "AwsDataCatalog"."finance-lake_db"."returns"
    with (
      table_type='hive',
      is_external=true,external_location='s3://finance-lake-query-vk1911eu/tables/finance-lake_db/returns/1c6cc33c-89fe-48ae-a182-7aaa289ce55d',
      format='parquet'
    )
    as
      

with base as (
  select
    symbol,
    date,
    close
  from "AwsDataCatalog"."finance-lake_db"."equities_clean"
),
calc as (
  select
    symbol,
    date,
    close,
    lag(close) over (partition by symbol order by date)        as prev_close
  from base
)
select
  symbol,
  date,
  close,
  case
    when prev_close is null or prev_close = 0 then null
    else (close - prev_close) / prev_close
  end as daily_return
from calc
