-- /* {"app": "dbt", "dbt_version": "1.10.13", "profile_name": "finance_lakehouse", "target_name": "dev", "node_id": "model.finance_lakehouse.macro_join"} */
create table "AwsDataCatalog"."finance-lake_db"."macro_join"
    with (
      table_type='hive',
      is_external=true,external_location='s3://finance-lake-query-vk1911eu/tables/finance-lake_db/macro_join/47338e19-7f77-42f9-a30c-d42a048f5634',
      format='parquet'
    )
    as
      

with fred as (
  select
    series,
    obs_date as date,
    cast(value as double) as value
  from "AwsDataCatalog"."finance-lake_db"."fred_clean"
  where series in ('DGS10','CPIAUCSL','UNRATE','TB3MS')
),
fred_pivot as (
  select
    date,
    max(case when series='DGS10'    then value end) as dgs10,
    max(case when series='CPIAUCSL' then value end) as cpiaucsl,
    max(case when series='UNRATE'   then value end) as unrate,
    max(case when series='TB3MS'    then value end) as tb3ms
  from fred
  group by date
),
r as (
  select symbol, date, daily_return
  from "AwsDataCatalog"."finance-lake_db"."returns"
)
select
  r.symbol,
  r.date,
  r.daily_return,
  p.dgs10,
  p.cpiaucsl,
  p.unrate,
  p.tb3ms
from r r
left join fred_pivot p
  on p.date = r.date
